# copy to .env (gitignored) local dev only
# SQL Server policy: 8+ chars from 3 of upper/lower/digit/symbol, otherwise the sql container exits
MSSQL_SA_PASSWORD=<change-your-password>

# emulator connections, keys are documented in the azurite / service bus emulator / cosmos emulator docs
STORAGE_CONNECTION_STRING='DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=<azurite-account-key>;BlobEndpoint=http://azurite:10000/devstoreaccount1;'
SERVICEBUS_CONNECTION_STRING='Endpoint=sb://servicebus;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;'
COSMOS_KEY=<cosmos-emulator-key>

# mock = fake extraction
EXTRACTOR=mock
DOCINTEL_ENDPOINT=
DOCINTEL_KEY=
